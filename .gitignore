# =========================================
# 🧠 SuperCMS Backend - .gitignore
# =========================================

# 🔒 Archivos de entorno
.env
.env.local
.env.*.local

# 🗂️ Dependencias de Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ⚙️ Archivos de configuración temporales
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
*.tmp
*.bak

# 📦 Compilaciones o builds
dist/
build/
coverage/

# 🖼️ Archivos generados (QRs, uploads, etc.)
qr_images/
uploads/
temp/
cache/

# ⚡ Archivos de base de datos locales
*.sqlite
*.db
*.sql~
migrate_test.sql

# 🚀 Archivos de despliegue (si usas Docker)
docker-compose.override.yml
.env.docker
.env.production.local

# 🧪 Tests
jest-report/
coverage/
*.spec.js
*.test.js
